# EIA API key - register at https://www.eia.gov/opendata/register.php
EIA_API_KEY=your-eia-api-key-here

# Date range shared by both sources (UTC, YYYY-MM-DD)
START_DATE=2019-01-01
END_DATE=2026-09-30

# EIA balancing authorities (comma-separated)
EIA_RESPONDENTS=NYIS,ERCO,CISO

# Open-Meteo: one representative city per region, as CODE:LAT:LON
OPENMETEO_LOCATIONS=NYIS:40.71:-74.01,ERCO:29.76:-95.37,CISO:34.05:-118.24
OPENMETEO_HOURLY=temperature_2m,relative_humidity_2m,precipitation